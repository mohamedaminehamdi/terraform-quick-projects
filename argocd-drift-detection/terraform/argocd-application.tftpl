apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: three-tier-gitops-app
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${gitops_repo_url}
    targetRevision: ${gitops_target_revision}
    path: ${gitops_repo_path}
  destination:
    server: https://kubernetes.default.svc
    namespace: ${app_namespace}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
